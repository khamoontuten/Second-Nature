# Second Nature configuration. Copy to .env and fill in what you need; never commit .env.
# All variables use the SN_ prefix (app/core/config.py). Defaults work for a local workstation install.

SN_ENVIRONMENT=development
SN_LOG_LEVEL=INFO

# Database: SQLite file by default. For PostgreSQL (+ PostGIS if available) use e.g.
# SN_DATABASE_URL=postgresql+psycopg://second_nature:change-me@localhost:5432/second_nature
# SN_DATABASE_URL=sqlite:///./data/second_nature.db

# Where datasets, results and reports are written (default: <repo>/data)
# SN_DATA_DIR=./data

# Identify yourself to public APIs (recommended by Nominatim / Open-Meteo usage policies)
SN_CONTACT_EMAIL=

# Climate provider fallback order (open_meteo, nasa_power, cds_era5)
SN_CLIMATE_PROVIDER_ORDER=["open_meteo","nasa_power"]

# Copernicus Climate Data Store (ERA5 / ERA5-Land). Personal access token from your CDS profile page.
SN_CDS_API_KEY=
# SN_CDS_API_URL=https://cds.climate.copernicus.eu/api

# Electricity Maps (hourly grid carbon intensity). Leave empty to use a manual factor or an uploaded series.
SN_ELECTRICITY_MAPS_API_KEY=

# Geocoder: open_meteo or nominatim
SN_GEOCODER=open_meteo

SN_JOB_WORKERS=2
SN_RATE_LIMIT_PER_MINUTE=120
SN_MAX_UPLOAD_MB=50
SN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
